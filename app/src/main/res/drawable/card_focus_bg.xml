<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused & Selected -->
    <item android:state_focused="true" android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/card_bg_focused" />
            <stroke android:width="3dp" android:color="@color/card_border_focused" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <!-- Focused only -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/card_bg_focused" />
            <stroke android:width="3dp" android:color="@color/card_border_focused" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <!-- Selected only -->
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/card_bg_selected" />
            <stroke android:width="2dp" android:color="@color/card_border_selected" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <!-- Default -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/card_bg" />
            <stroke android:width="1dp" android:color="@color/card_border" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</selector>

